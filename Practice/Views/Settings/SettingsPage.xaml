<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practice.Views.SettingsPage"
             Title="Settings">
    <StackLayout>
        <Label Text="Welcome to practice app" />
        <Button Text="About" Command="{Binding AboutCommand}" />
        <Switch IsToggled="{Binding IsDarkTheme, Mode=TwoWay}" />
        <Label Text="Developed by MKN-11 Team" 
           FontSize="Small"
           TextColor="Gray"
           HorizontalOptions="Center"/>
        <Label Text="{Binding Version}" 
            FontSize="Small" 
            TextColor="Gray" 
            HorizontalOptions="Center"/>
    </StackLayout>
</ContentPage>