<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practice.Views.EditProfilePage"
             xmlns:local="clr-namespace:Practice.Views"
             Title="EditProfilePage">
    <StackLayout Padding="10, 0">
        <Entry x:Name="FirstName"
               Text=""
               Placeholder="First name"
               VerticalOptions="Center" />
        <Entry x:Name="LastName"
               Text=""
               Placeholder="Last name"
               VerticalOptions="Center" />
        <Button x:DataType="Entry"
                Text="Submit"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsEnabled="{Binding Source={x:Reference LastName}}" />
    </StackLayout>
</ContentPage>