<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practice.Views.LoginPage"
             Title="LoginPage"
             xmlns:local="clr-namespace:Practice.Views"
             x:DataType="local:LoginPageViewModel">
    <VerticalStackLayout Padding="30" Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <Label Text="Login"
               FontSize="32"
               HorizontalOptions="Center"
               TextColor="White"/>

        <Entry x:Name="UsernameEntry"
               Placeholder="User Name"
               PlaceholderColor="LightGray"
               TextColor="White"
               BackgroundColor="#5e4b8b"
               Margin="0,10"
               HeightRequest="50"/>

        <Entry x:Name="PasswordEntry"
               Placeholder="Password"
               PlaceholderColor="LightGray"
               TextColor="White"
               IsPassword="True"
               BackgroundColor="#5e4b8b"
               HeightRequest="50"/>

        <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" VerticalOptions="Center">
            <CheckBox x:Name="RememberMeCheckBox" Color="White"/>
            <Label Text="Remember Me"
                   VerticalOptions="Center"
                   TextColor="White"
                   Margin="5,0,20,0"/>
            <Label Text="Forget Me ?"
                   VerticalOptions="Center"
                   TextColor="LightBlue"
                   HorizontalOptions="End"/>
        </StackLayout>

        <Button Text="Login"
                BackgroundColor="#b5179e"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="25"
                Command="{Binding LoginCommand}"
               />
    </VerticalStackLayout>
</ContentPage>