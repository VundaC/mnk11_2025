<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practice.Views.LoginPage"
             Title="LoginPage"
             xmlns:local="clr-namespace:Practice.Views"
             x:DataType="local:LoginPageViewModel"
             BackgroundImageSource="https://img.freepik.com/premium-vector/abstract-modern-gradient-background-with-wavy-lines_745217-146.jpg?w=996">
    <VerticalStackLayout Padding="30" Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <Label Text="Login"
               FontSize="32"
               HorizontalOptions="Center"
               TextColor="White"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Entry x:Name="UsernameEntry"
Text="{Binding Username}"
Placeholder="Username"
PlaceholderColor="LightGray"
TextColor="White"
             
           Grid.Column="0"
           Grid.ColumnSpan="2"
BackgroundColor="#5e4b8b"
Margin="0,10"
HeightRequest="50"/>
            <Image Source="person.png"
    Grid.Column="0"
    VerticalOptions="Center"/>
        </Grid>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Padding="20,0"
       BackgroundColor="#5e4b8b"
       StrokeShape="RoundRectangle 5,5,5,5"
       HeightRequest="50"
       Grid.Column="0"
       Grid.ColumnSpan="2">
                <Entry x:Name="PasswordEntry"
           Text="{Binding Password}"
           Placeholder="Password"
           PlaceholderColor="LightGray"
           TextColor="White"
           IsPassword="True"
           BackgroundColor="Transparent" />
            </Border>
            <Image Source="password.png"
           Grid.Column="0"
           VerticalOptions="Center"/>
        </Grid>
        

        <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" VerticalOptions="Center">
            <CheckBox x:Name="RememberMeCheckBox" Color="White"/>
            <Label Text="Remember Me"
                   VerticalOptions="Center"
                   TextColor="White"
                   Margin="5,0,20,0"/>
            <Label Text="Forget Me ?"
                   VerticalOptions="Center"
                   TextColor="White"
                   HorizontalOptions="End"/>
        </StackLayout>

        <Button Text="Login"
                BackgroundColor="#b5179e"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="25"
                Command="{Binding LoginCommand}"
               />
    </VerticalStackLayout>
</ContentPage>