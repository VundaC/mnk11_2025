<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Practice.Views"
             x:DataType="{x:Type views:BlePageViewModel}"
             x:Class="Practice.Views.BlePage">

    <StackLayout Padding="20">
        <Label Text="Bluetooth Scanner"
               FontSize="24"
               HorizontalOptions="Center"
               Margin="0, 10, 0, 20" />

        <!-- Scan Button -->
        <Button Text="Scan for Bluetooth Devices"
                x:Name="ScanButton"
                Command="{Binding ScanCommand}" />

        <!-- CollectionView for displaying devices -->
        <CollectionView ItemsSource="{Binding Devices}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Name}" FontSize="18" />
                        <Label Text="{Binding Id}" FontSize="14" TextColor="Gray" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>