<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  throwConfigExceptions="true">
	<extensions>
		<add assembly="NLog.Targets.MauiLog" />
	</extensions>
	<targets>
		<target name="mauilog" type="MauiLog" />
		<!--<target name="jsonFile" xsi:type="File" fileName="log-file.json" >
			<layout xsi:type="JsonLayout" includeEventProperties="Boolean" excludeProperties="Comma-separated list (string)">
				<attribute name="time" layout="${longdate}" />
				<attribute name="level" layout="${level:upperCase=true}"/>
				<attribute name="message" layout="${message}" />
			</layout>
		</target>-->
	</targets>
	

	<rules>
		<!--<logger name="*" minlevel="Info" writeTo="logconsole" />-->
		<logger name="*" minlevel="Debug" writeTo="mauilog" />
	</rules>
</nlog>